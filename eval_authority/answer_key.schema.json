{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eval-authority.local/schemas/answer_key/v1.json",
  "title": "ADII answer key, schema_version 1",
  "description": "Published schema for eval_authority answer keys. This file and versioning.py's SCHEMA_FIELDS_BY_VERSION[\"1\"] are checked against each other by test_schema_matches_code.py (C5) — a corpus of valid and invalid documents must produce identical accept/reject verdicts from both.",
  "type": "object",
  "required": ["schema_version", "incident_id", "correct_disposition"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "incident_id": { "type": "string", "minLength": 1 },
    "authored_by": { "type": "string" },
    "authored_at": { "type": "string" },
    "source_of_truth": { "type": "string" },
    "purpose": { "type": "string" },
    "correct_disposition": {
      "type": "string",
      "enum": ["REPAIR", "NO_REPAIR", "ESCALATE"]
    },
    "correct_root_cause_id": { "type": ["string", "null"] },
    "root_cause_explanation": { "type": "string" },
    "repair_must_satisfy": { "type": "object" },
    "why_not_repair": { "type": "string" },
    "why_not_no_repair": { "type": "string" },
    "why_not_escalate": { "type": "string" },
    "scoring_notes": { "type": "object" },
    "test_fixtures": { "type": "object" },
    "frozen": { "type": "boolean" },
    "freeze_note": { "type": "string" }
  }
}
