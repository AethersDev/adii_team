.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store
Thumbs.db
# Run archives. Payloads are machine-produced and bulk, so they stay out of history.
# Ignoring is not preserving (inherited CONFORMANCE D13): the README and, later, the
# manifest beside them are tracked, so what exists is attested even when the bytes are not.
01_data/runs/*
!01_data/runs/README.md
!01_data/runs/MANIFEST.json

# Environment / secrets — .env.local holds the operator's real key and never enters history
.env
.env.local
.env.*
!.env.example

# Test / coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python build output
build/

# the paper's build outputs; paper/paper.md is the source
paper/paper.tex
paper/paper.html
paper/*.pdf
!paper/permission-is-not-justification.pdf
paper/*.zip
dist/

# Logs — but an incident's evidence is data, whatever its extension: a .log under
# 01_data/incidents is a package file the freeze digests, and every clone needs it
*.log
!01_data/incidents/**/*.log

# the submission ZIP: built from a tag by 02_src/scripts/package_submission.py
ADII_Group05_Code_v1.zip
ADII_Group05_Code_v1.sha256

# the film in progress; the finished film enters at Freeze B (final plan 7.5)
03_assets/identity/filmadii/
